{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Denpa Jack",
  "version": "0.3.1",
  "identifier": "io.github.yangyaofei.denpajack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Denpa Jack",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yangyaofei/denpa-jack/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQUU5MDc3RDM4N0ZFODQKUldTRS9vZlRkNUN1VG1xOXdiUnpRa2FMalFBQUx5Z0VROERiajdLWFhBNForc0N2UGlxZ3pxd0oK"
    }
  }
}